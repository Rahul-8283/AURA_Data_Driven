# --- Backend Environment Variables ---

# Server Config
PORT=8000

# Core Database & Storage (Supabase)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-never-share
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-id.supabase.co:5432/postgres
SUPABASE_JWT_SECRET=your_jwt_secret

# Graph Database (Neo4j)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password

# Vector Database (chromadb)
CHROMA_DATABASE=database

# AI Engine API (OpenRouter or Gemini)
OPENROUTER_API_KEY=sk-or-v1-...
GEMINI_API_KEY=your_gemini_api_key

# Embedding Model (Hugging Face API)
HF_API_KEY=your_hf_api_key_here

# Celery Background Tasks (Upstash Redis)
REDIS_URL=rediss://default:your_upstash_password@your-upstash-url.upstash.io:6379

# Genetic algorithm sizing (defaults: 20 generations, 10 seeds, 20 population).
# Lower GA_GENERATIONS for quick test runs against a limited LLM quota.
GA_GENERATIONS=20
GA_SEED_POPULATION=10
GA_POPULATION_SIZE=20

# Automatic Ingestion & Literature Harvesters
# PubMed NCBI API Key (Optional: raises rate limit from 3 to 10 req/sec)
NCBI_API_KEY=
# YOUR contact email, sent to arXiv/Crossref/Wikipedia/NCBI in the User-Agent so they can reach you
# if the harvester misbehaves. Leave blank to send no address.
CONTACT_EMAIL=
# LLM requests one triplet-extraction run may spend (each covers GRAPH_EXTRACTION_GROUP_SIZE chunks).
GRAPH_EXTRACTION_MAX_CALLS=10
GRAPH_EXTRACTION_GROUP_SIZE=4
# Nightly literature sweep at 02:00 UTC. Needs a separate process: celery -A app.core.celery_app.celery_app beat
NIGHTLY_HARVEST_ENABLED=false
